  CheckBox #TelemetryConsentStatsEnabled { Anchor: (Top: 17, Left: 634, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
  TextButton #TelemetryConsentStatsToggleButton { Anchor: (Left: 618, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
  Group #TelemetryConsentStatsUnsupported { Anchor: (Top: 17, Left: 634, Width: 22, Height: 22); Visible: false; Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Label { Anchor: (Width: 22, Height: 22); Text: "-"; Style: @TelemetryConsentUnsupportedCellLabel; } }
  CheckBox #TelemetryConsentBreadcrumbsEnabled { Anchor: (Top: 17, Left: 689, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
  TextButton #TelemetryConsentBreadcrumbsToggleButton { Anchor: (Left: 673, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
  Group #TelemetryConsentBreadcrumbsUnsupported { Anchor: (Top: 17, Left: 689, Width: 22, Height: 22); Visible: false; Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Label { Anchor: (Width: 22, Height: 22); Text: "-"; Style: @TelemetryConsentUnsupportedCellLabel; } }
