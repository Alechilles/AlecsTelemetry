  Group #TelemetryConsentCaptureUnsupported { Anchor: (Top: 17, Left: 359, Width: 22, Height: 22); Visible: false; Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Label { Anchor: (Width: 22, Height: 22); Text: "-"; Style: @TelemetryConsentUnsupportedCellLabel; } }
  CheckBox #TelemetryConsentErrorEnabled { Anchor: (Top: 17, Left: 414, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
  TextButton #TelemetryConsentErrorToggleButton { Anchor: (Left: 398, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
  Group #TelemetryConsentErrorUnsupported { Anchor: (Top: 17, Left: 414, Width: 22, Height: 22); Visible: false; Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Label { Anchor: (Width: 22, Height: 22); Text: "-"; Style: @TelemetryConsentUnsupportedCellLabel; } }
