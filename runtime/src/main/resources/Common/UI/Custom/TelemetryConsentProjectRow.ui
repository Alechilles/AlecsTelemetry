  CheckBox #TelemetryConsentUsageEnabled { Anchor: (Top: 17, Left: 579, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
