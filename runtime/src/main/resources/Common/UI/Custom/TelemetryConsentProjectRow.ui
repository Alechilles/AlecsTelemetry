  CheckBox #TelemetryConsentPerformanceEnabled { Anchor: (Top: 17, Left: 524, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
