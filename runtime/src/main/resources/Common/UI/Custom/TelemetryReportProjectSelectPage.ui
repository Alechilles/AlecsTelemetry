$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TelemetryReportProjectSelectRoot {
    @TitleHeight = 96;

    Anchor: (Width: 620, Height: 610);

    #Title {
      Anchor: (Height: 96, Top: 0);
      Background: "TelemetryConsentHeader.png";
      Padding: (Top: 8, Bottom: 8);

      Group #TelemetryReportProjectSelectLogo {
        Anchor: (Width: 221, Height: 80);
        Background: "AlecsTelemetryLogo.png";
      }
    }

    #Content {
      Anchor: (Top: 96);
      LayoutMode: Top;
      Padding: (Left: 14, Right: 14, Top: 12, Bottom: 12);

      Label {
        Anchor: (Height: 30);
        Text: "Choose a project";
        Style: (FontSize: 18, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Group {
        Anchor: (Height: 30);
        LayoutMode: Left;

        Label {
          Anchor: (Width: 74, Height: 26);
          Text: "Report:";
          Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Label #TelemetryReportProjectSelectKind {
          Anchor: (Width: 160, Height: 26);
          Text: "";
          Style: (FontSize: 13, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center);
        }
      }

      Label #TelemetryReportProjectSelectEmpty {
        Anchor: (Height: 40);
        Text: "No telemetry projects currently accept player reports.";
        Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Label #TelemetryReportProjectSelectOverflow {
        Anchor: (Height: 26);
        Text: "";
        Style: (FontSize: 12, TextColor: #ffcf77, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group {
        FlexWeight: 1;
        Background: #13243a;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Group {
          LayoutMode: Top;
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);

          Group #TelemetryReportProjectSelectRow0 { Anchor: (Height: 78); LayoutMode: Left; Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 6, Bottom: 6); Group #TelemetryReportProjectSelectIconFrame { Anchor: (Width: 66); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryReportProjectSelectIconImage { Anchor: (Width: 66, Height: 66); Background: #203a5a; Label #TelemetryReportProjectSelectIconPlaceholder { Anchor: (Width: 66, Height: 66); Text: "?"; Style: (FontSize: 22, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Left: 10); Label #TelemetryReportProjectSelectName { Anchor: (Height: 28); Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } Label #TelemetryReportProjectSelectMeta { Anchor: (Height: 20); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } } $C.@SmallSecondaryTextButton #TelemetryReportProjectSelectOpen { @Sounds = $C.@ButtonSounds; @Text = "Open"; @Anchor = (MinWidth: 74); } }
          Group #TelemetryReportProjectSelectRow1 { Anchor: (Height: 78); LayoutMode: Left; Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 6, Bottom: 6); Group #TelemetryReportProjectSelectIconFrame { Anchor: (Width: 66); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryReportProjectSelectIconImage { Anchor: (Width: 66, Height: 66); Background: #203a5a; Label #TelemetryReportProjectSelectIconPlaceholder { Anchor: (Width: 66, Height: 66); Text: "?"; Style: (FontSize: 22, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Left: 10); Label #TelemetryReportProjectSelectName { Anchor: (Height: 28); Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } Label #TelemetryReportProjectSelectMeta { Anchor: (Height: 20); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } } $C.@SmallSecondaryTextButton #TelemetryReportProjectSelectOpen { @Sounds = $C.@ButtonSounds; @Text = "Open"; @Anchor = (MinWidth: 74); } }
          Group #TelemetryReportProjectSelectRow2 { Anchor: (Height: 78); LayoutMode: Left; Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 6, Bottom: 6); Group #TelemetryReportProjectSelectIconFrame { Anchor: (Width: 66); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryReportProjectSelectIconImage { Anchor: (Width: 66, Height: 66); Background: #203a5a; Label #TelemetryReportProjectSelectIconPlaceholder { Anchor: (Width: 66, Height: 66); Text: "?"; Style: (FontSize: 22, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Left: 10); Label #TelemetryReportProjectSelectName { Anchor: (Height: 28); Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } Label #TelemetryReportProjectSelectMeta { Anchor: (Height: 20); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } } $C.@SmallSecondaryTextButton #TelemetryReportProjectSelectOpen { @Sounds = $C.@ButtonSounds; @Text = "Open"; @Anchor = (MinWidth: 74); } }
          Group #TelemetryReportProjectSelectRow3 { Anchor: (Height: 78); LayoutMode: Left; Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 6, Bottom: 6); Group #TelemetryReportProjectSelectIconFrame { Anchor: (Width: 66); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryReportProjectSelectIconImage { Anchor: (Width: 66, Height: 66); Background: #203a5a; Label #TelemetryReportProjectSelectIconPlaceholder { Anchor: (Width: 66, Height: 66); Text: "?"; Style: (FontSize: 22, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Left: 10); Label #TelemetryReportProjectSelectName { Anchor: (Height: 28); Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } Label #TelemetryReportProjectSelectMeta { Anchor: (Height: 20); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } } $C.@SmallSecondaryTextButton #TelemetryReportProjectSelectOpen { @Sounds = $C.@ButtonSounds; @Text = "Open"; @Anchor = (MinWidth: 74); } }
          Group #TelemetryReportProjectSelectRow4 { Anchor: (Height: 78); LayoutMode: Left; Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 6, Bottom: 6); Group #TelemetryReportProjectSelectIconFrame { Anchor: (Width: 66); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryReportProjectSelectIconImage { Anchor: (Width: 66, Height: 66); Background: #203a5a; Label #TelemetryReportProjectSelectIconPlaceholder { Anchor: (Width: 66, Height: 66); Text: "?"; Style: (FontSize: 22, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } } Group { LayoutMode: Top; FlexWeight: 1; Padding: (Left: 10); Label #TelemetryReportProjectSelectName { Anchor: (Height: 28); Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } Label #TelemetryReportProjectSelectMeta { Anchor: (Height: 20); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } } $C.@SmallSecondaryTextButton #TelemetryReportProjectSelectOpen { @Sounds = $C.@ButtonSounds; @Text = "Open"; @Anchor = (MinWidth: 74); } }
        }
      }

      Group {
        Anchor: (Height: 42);
        LayoutMode: Right;

        $C.@SmallSecondaryTextButton #TelemetryReportProjectSelectCancel {
          @Sounds = $C.@ButtonSounds;
          @Text = "Cancel";
          @Anchor = (MinWidth: 96);
        }
      }
    }
  }
}
