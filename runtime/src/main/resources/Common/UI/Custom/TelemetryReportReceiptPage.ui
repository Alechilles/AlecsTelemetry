$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TelemetryReportReceiptRoot {
    Anchor: (Width: 520, Height: 320);

    #Content {
      LayoutMode: Top;
      Padding: (Left: 16, Right: 16, Top: 16, Bottom: 14);

      Label {
        Anchor: (Height: 34);
        Text: "Report submitted";
        Style: (FontSize: 18, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label #TelemetryReportReceiptProject { Anchor: (Height: 28); Text: ""; Style: (FontSize: 13, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center); }
      Label #TelemetryReportReceiptKind { Anchor: (Height: 28); Text: ""; Style: (FontSize: 13, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Center); }
      Label #TelemetryReportReceiptStatus { Anchor: (Height: 38); Text: ""; Style: (FontSize: 13, TextColor: #ffcf77, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true); }

      Label { Anchor: (Height: 20); Text: "Report ID"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
      Label #TelemetryReportReceiptId {
        Anchor: (Height: 46);
        Text: "";
        Background: #0f1e30;
        Style: (FontSize: 12, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group { FlexWeight: 1; }

      Group { Anchor: (Height: 42); LayoutMode: Right;
        $C.@SmallSecondaryTextButton #TelemetryReportReceiptRefresh { @Sounds = $C.@ButtonSounds; @Text = "Refresh"; @Anchor = (MinWidth: 96); }
        $C.@SmallSecondaryTextButton #TelemetryReportReceiptClose { @Sounds = $C.@ButtonSounds; @Text = "Close"; @Anchor = (MinWidth: 96); }
      }
    }
  }
}
