            }

            Group #TelemetryConsentProjectRow2 { Anchor: (Height: 104); LayoutMode: Left; Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);
              Group #TelemetryConsentProjectIconFrame { Anchor: (Width: 88); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryConsentProjectIconImage { Anchor: (Width: 88, Height: 88); Background: #203a5a; Label #TelemetryConsentProjectIconPlaceholder { Anchor: (Width: 88, Height: 88); Text: "?"; Style: (FontSize: 24, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } }
