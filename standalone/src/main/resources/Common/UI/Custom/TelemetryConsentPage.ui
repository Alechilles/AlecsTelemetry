$C = "Common.ui";

@TelemetryConsentHintStyle = TextTooltipStyle(
  Background: #0f1e30(0.96),
  MaxWidth: 320,
  LabelStyle: (Wrap: true, FontSize: 12, TextColor: #eef4fb),
  Padding: 12
);

@TelemetryConsentHeaderLabel = LabelStyle(
  FontSize: 10,
  TextColor: #bfd0e5,
  HorizontalAlignment: Center,
  VerticalAlignment: Center,
  Wrap: false
);

@TelemetryConsentProjectHeaderLabel = LabelStyle(
  FontSize: 11,
  TextColor: #dce9f8,
  HorizontalAlignment: Start,
  VerticalAlignment: Center,
  Wrap: false
);

@TelemetryConsentInvisibleButtonStyle = TextButtonStyle(
  Default: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Hovered: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Pressed: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Disabled: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000))
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TelemetryConsentRoot {
    @TitleHeight = 128;

    Anchor: (Width: 780, Height: 710);

    #Title {
      Anchor: (Height: 128, Top: 0);
      Background: "TelemetryConsentHeader.png";
      Padding: (Top: 10, Bottom: 10);

      Group #TelemetryConsentLogo {
        Anchor: (Width: 299, Height: 108);
        Background: "AlecsTelemetryLogo.png";
      }
    }

    #Content {
      Anchor: (Top: 128);
      LayoutMode: Top;
      Padding: (Left: 12, Right: 12, Top: 8, Bottom: 10);

      Label #TelemetryConsentSummary {
        Anchor: (Height: 58);
        Text: "";
        Style: (FontSize: 13, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
      }

      Label #TelemetryConsentEmpty {
        Anchor: (Height: 30);
        Text: "No telemetry-enabled projects are currently registered.";
        Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Label #TelemetryConsentOverflow {
        Anchor: (Height: 22);
        Text: "";
        Style: (FontSize: 12, TextColor: #ffcf77, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: #13243a;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Group #TelemetryConsentGridHeader {
          Anchor: (Width: 740, Height: 64);
          Background: #172b45;
          Group { Anchor: (Left: 300, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
          Group { Anchor: (Left: 355, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
          Group { Anchor: (Left: 410, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
          Group { Anchor: (Left: 465, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
          Group { Anchor: (Left: 520, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
          Group { Anchor: (Left: 575, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
          Group { Anchor: (Left: 630, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
          Group { Anchor: (Left: 685, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
          Group { Anchor: (Left: 0, Right: 0, Top: 63, Height: 1); Background: #28415f; }
          Label {
            Anchor: (Left: 8, Width: 292, Top: 5, Height: 24);
            Text: "Project";
            Style: @TelemetryConsentProjectHeaderLabel;
          }

          Label {
            Anchor: (Left: 300, Width: 55, Top: 5, Height: 24);
            Text: "Enable";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Enables or disables all telemetry categories for every listed mod.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentAllEnabled {
            Anchor: (Top: 34, Left: 316, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
          TextButton #TelemetryConsentAllToggleButton {
            Anchor: (Left: 300, Width: 55, Top: 0, Height: 64);
            Text: "";
            TooltipText: "Enables or disables all telemetry categories for every listed mod.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
            Style: @TelemetryConsentInvisibleButtonStyle;
          }

          Label {
            Anchor: (Left: 355, Width: 55, Top: 5, Height: 24);
            Text: "Crash";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Crash reports, uncaught exceptions, setup failures, start failures, and exceptional world removals.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentCrashAllEnabled {
            Anchor: (Top: 34, Left: 371, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
          TextButton #TelemetryConsentCrashAllToggleButton {
            Anchor: (Left: 355, Width: 55, Top: 0, Height: 64);
            Text: "";
            TooltipText: "Crash reports, uncaught exceptions, setup failures, start failures, and exceptional world removals.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
            Style: @TelemetryConsentInvisibleButtonStyle;
          }

          Label {
            Anchor: (Left: 410, Width: 55, Top: 5, Height: 24);
            Text: "Error";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Handled errors that did not crash the game, with descriptor-allowed context.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentErrorAllEnabled {
            Anchor: (Top: 34, Left: 426, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
          TextButton #TelemetryConsentErrorAllToggleButton {
            Anchor: (Left: 410, Width: 55, Top: 0, Height: 64);
            Text: "";
            TooltipText: "Handled errors that did not crash the game, with descriptor-allowed context.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
            Style: @TelemetryConsentInvisibleButtonStyle;
          }

          Label {
            Anchor: (Left: 465, Width: 55, Top: 5, Height: 24);
            Text: "Life";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Lifecycle events such as setup, start, reload, and other timed mod operations.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentLifecycleAllEnabled {
            Anchor: (Top: 34, Left: 481, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
          TextButton #TelemetryConsentLifecycleAllToggleButton {
            Anchor: (Left: 465, Width: 55, Top: 0, Height: 64);
            Text: "";
            TooltipText: "Lifecycle events such as setup, start, reload, and other timed mod operations.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
            Style: @TelemetryConsentInvisibleButtonStyle;
          }

          Label {
            Anchor: (Left: 520, Width: 55, Top: 5, Height: 24);
            Text: "Perf";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Performance timings and slow operation measurements.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentPerformanceAllEnabled {
            Anchor: (Top: 34, Left: 536, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
          TextButton #TelemetryConsentPerformanceAllToggleButton {
            Anchor: (Left: 520, Width: 55, Top: 0, Height: 64);
            Text: "";
            TooltipText: "Performance timings and slow operation measurements.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
            Style: @TelemetryConsentInvisibleButtonStyle;
          }

          Label {
            Anchor: (Left: 575, Width: 55, Top: 5, Height: 24);
            Text: "Usage";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Feature and command usage events declared by the mod.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentUsageAllEnabled {
            Anchor: (Top: 34, Left: 591, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
          TextButton #TelemetryConsentUsageAllToggleButton {
            Anchor: (Left: 575, Width: 55, Top: 0, Height: 64);
            Text: "";
            TooltipText: "Feature and command usage events declared by the mod.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
            Style: @TelemetryConsentInvisibleButtonStyle;
          }

          Label {
            Anchor: (Left: 630, Width: 55, Top: 5, Height: 24);
            Text: "Stats";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Low-frequency aggregate stats such as heartbeat and player-count style observations.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentStatsAllEnabled {
            Anchor: (Top: 34, Left: 646, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
          TextButton #TelemetryConsentStatsAllToggleButton {
            Anchor: (Left: 630, Width: 55, Top: 0, Height: 64);
            Text: "";
            TooltipText: "Low-frequency aggregate stats such as heartbeat and player-count style observations.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
            Style: @TelemetryConsentInvisibleButtonStyle;
          }

          Label {
            Anchor: (Left: 685, Width: 55, Top: 5, Height: 24);
            Text: "Crumbs";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Recent breadcrumbs attached to crash or error reports to explain what happened before failure.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentBreadcrumbsAllEnabled {
            Anchor: (Top: 34, Left: 701, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
          TextButton #TelemetryConsentBreadcrumbsAllToggleButton {
            Anchor: (Left: 685, Width: 55, Top: 0, Height: 64);
            Text: "";
            TooltipText: "Recent breadcrumbs attached to crash or error reports to explain what happened before failure.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
            Style: @TelemetryConsentInvisibleButtonStyle;
          }
        }

        Group #TelemetryConsentViewport {
          FlexWeight: 1;
          LayoutMode: Top;
          Padding: (Left: 0, Right: 0, Top: 0, Bottom: 0);

          Group #TelemetryConsentRows {
            LayoutMode: Top;
            Anchor: (Width: 740, Bottom: 0);

            Group #TelemetryConsentProjectRow0 { Anchor: (Width: 740, Height: 56); Background: #0f1e30;
              Group { Anchor: (Left: 300, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
              Group { Anchor: (Left: 355, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
              Group { Anchor: (Left: 410, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
              Group { Anchor: (Left: 465, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
              Group { Anchor: (Left: 520, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
              Group { Anchor: (Left: 575, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
              Group { Anchor: (Left: 630, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
              Group { Anchor: (Left: 685, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
              Group { Anchor: (Left: 0, Right: 0, Top: 55, Height: 1); Background: #28415f; }
              Group #TelemetryConsentProjectIconFrame { Anchor: (Left: 0, Top: 0, Width: 56, Height: 56); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryConsentProjectIconImage { Anchor: (Width: 56, Height: 56); Background: #203a5a; Label #TelemetryConsentProjectIconPlaceholder { Anchor: (Width: 56, Height: 56); Text: "?"; Style: (FontSize: 22, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } }
              Label #TelemetryConsentProjectName { Anchor: (Left: 64, Top: 7, Width: 228, Height: 22); Text: ""; Style: (FontSize: 14, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
              Label #TelemetryConsentProjectMeta { Anchor: (Left: 64, Top: 30, Width: 228, Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
              CheckBox #TelemetryConsentProjectEnabled { Anchor: (Top: 17, Left: 316, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentProjectToggleButton { Anchor: (Left: 300, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
              CheckBox #TelemetryConsentCrashEnabled { Anchor: (Top: 17, Left: 371, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentCrashToggleButton { Anchor: (Left: 355, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
              CheckBox #TelemetryConsentErrorEnabled { Anchor: (Top: 17, Left: 426, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentErrorToggleButton { Anchor: (Left: 410, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
              CheckBox #TelemetryConsentLifecycleEnabled { Anchor: (Top: 17, Left: 481, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentLifecycleToggleButton { Anchor: (Left: 465, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
              CheckBox #TelemetryConsentPerformanceEnabled { Anchor: (Top: 17, Left: 536, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentPerformanceToggleButton { Anchor: (Left: 520, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
              CheckBox #TelemetryConsentUsageEnabled { Anchor: (Top: 17, Left: 591, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentUsageToggleButton { Anchor: (Left: 575, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
              CheckBox #TelemetryConsentStatsEnabled { Anchor: (Top: 17, Left: 646, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentStatsToggleButton { Anchor: (Left: 630, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
              CheckBox #TelemetryConsentBreadcrumbsEnabled { Anchor: (Top: 17, Left: 701, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentBreadcrumbsToggleButton { Anchor: (Left: 685, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
            }
            Group #TelemetryConsentProjectRow1 { Anchor: (Width: 740, Height: 56); Background: #0f1e30;
              Group { Anchor: (Left: 300, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
              Group { Anchor: (Left: 355, Width: 1, Top: 0, Bottom: 0); Background: #28415f; }
