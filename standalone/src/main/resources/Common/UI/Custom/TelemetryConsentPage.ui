$C = "Common.ui";

@TelemetryConsentHintStyle = TextTooltipStyle(
  Background: #0f1e30(0.96),
  MaxWidth: 320,
  LabelStyle: (Wrap: true, FontSize: 12, TextColor: #eef4fb),
  Padding: 12
);

@TelemetryConsentInvisibleButtonStyle = TextButtonStyle(
  Default: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Hovered: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Pressed: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Disabled: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000))
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TelemetryConsentRoot {
    @TitleHeight = 128;

    Anchor: (Width: 780, Height: 710);

    #Title {
      Anchor: (Height: 128, Top: 0);
      Background: "TelemetryConsentHeader.png";
      Padding: (Top: 10, Bottom: 10);

      Group #TelemetryConsentLogo {
        Anchor: (Width: 299, Height: 108);
        Background: "AlecsTelemetryLogo.png";
      }
    }

    #Content {
      Anchor: (Top: 128);
      LayoutMode: Top;
      Padding: (Left: 12, Right: 12, Top: 8, Bottom: 10);

      Label #TelemetryConsentSummary {
        Anchor: (Height: 58);
        Text: "";
        Style: (FontSize: 13, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
      }

      Group {
        Anchor: (Height: 32);

        Label {
          Anchor: (Left: 0, Width: 142, Height: 28);
          Text: "Enable all projects";
          Style: (FontSize: 13, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        CheckBox #TelemetryConsentAllEnabled {
          Anchor: (Top: 3, Left: 148, Width: 22, Height: 22);
          Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
          Padding: (Full: 4);
          Style: $C.@DefaultCheckBoxStyle;
        }

        Label #TelemetryConsentOverflow {
          Anchor: (Left: 184, Right: 0, Height: 28);
          Text: "";
          Style: (FontSize: 12, TextColor: #ffcf77, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
        }
      }

      Label #TelemetryConsentEmpty {
        Anchor: (Height: 30);
        Text: "No telemetry-enabled projects are currently registered.";
        Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group {
        FlexWeight: 1;
        Background: #13243a;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Group #TelemetryConsentViewport {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 4, Right: 0, Top: 2, Bottom: 2);

          Group #TelemetryConsentRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Bottom: 0);

            Group #TelemetryConsentProjectRow0 { Anchor: (Height: 104); LayoutMode: Left; Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);
              Group #TelemetryConsentProjectIconFrame { Anchor: (Width: 88); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryConsentProjectIconImage { Anchor: (Width: 88, Height: 88); Background: #203a5a; Label #TelemetryConsentProjectIconPlaceholder { Anchor: (Width: 88, Height: 88); Text: "?"; Style: (FontSize: 24, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } }
              Group { LayoutMode: Top; FlexWeight: 1; Padding: (Left: 8); Group { Anchor: (Height: 26); Label #TelemetryConsentProjectName { Anchor: (Left: 0, Right: 38, Height: 24); Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } CheckBox #TelemetryConsentProjectEnabled { Anchor: (Top: 1, Right: 8, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } } Label #TelemetryConsentProjectMeta { Anchor: (Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } Group { Anchor: (Height: 4); } Group { Anchor: (Height: 28); Label { Anchor: (Left: 0, Width: 36, Height: 24); Text: "Crash"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentCrashEnabled { Anchor: (Top: 1, Left: 38, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 74, Width: 32, Height: 24); Text: "Error"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentErrorEnabled { Anchor: (Top: 1, Left: 108, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 144, Width: 54, Height: 24); Text: "Lifecycle"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentLifecycleEnabled { Anchor: (Top: 1, Left: 200, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 236, Width: 76, Height: 24); Text: "Performance"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentPerformanceEnabled { Anchor: (Top: 1, Left: 314, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 350, Width: 38, Height: 24); Text: "Usage"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentUsageEnabled { Anchor: (Top: 1, Left: 390, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 426, Width: 32, Height: 24); Text: "Stats"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentStatsEnabled { Anchor: (Top: 1, Left: 460, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 496, Width: 78, Height: 24); Text: "Breadcrumbs"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentBreadcrumbsEnabled { Anchor: (Top: 1, Left: 576, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } } }
            }

            Group #TelemetryConsentProjectRow1 { Anchor: (Height: 104); LayoutMode: Left; Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);
              Group #TelemetryConsentProjectIconFrame { Anchor: (Width: 88); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryConsentProjectIconImage { Anchor: (Width: 88, Height: 88); Background: #203a5a; Label #TelemetryConsentProjectIconPlaceholder { Anchor: (Width: 88, Height: 88); Text: "?"; Style: (FontSize: 24, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } }
              Group { LayoutMode: Top; FlexWeight: 1; Padding: (Left: 8); Group { Anchor: (Height: 26); Label #TelemetryConsentProjectName { Anchor: (Left: 0, Right: 38, Height: 24); Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } CheckBox #TelemetryConsentProjectEnabled { Anchor: (Top: 1, Right: 8, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } } Label #TelemetryConsentProjectMeta { Anchor: (Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } Group { Anchor: (Height: 4); } Group { Anchor: (Height: 28); Label { Anchor: (Left: 0, Width: 36, Height: 24); Text: "Crash"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentCrashEnabled { Anchor: (Top: 1, Left: 38, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 74, Width: 32, Height: 24); Text: "Error"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentErrorEnabled { Anchor: (Top: 1, Left: 108, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 144, Width: 54, Height: 24); Text: "Lifecycle"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentLifecycleEnabled { Anchor: (Top: 1, Left: 200, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 236, Width: 76, Height: 24); Text: "Performanc