              TextButton #TelemetryConsentUsageToggleButton { Anchor: (Left: 575, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
              CheckBox #TelemetryConsentStatsEnabled { Anchor: (Top: 17, Left: 646, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentStatsToggleButton { Anchor: (Left: 630, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
              CheckBox #TelemetryConsentBreadcrumbsEnabled { Anchor: (Top: 17, Left: 701, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              TextButton #TelemetryConsentBreadcrumbsToggleButton { Anchor: (Left: 685, Width: 55, Top: 0, Height: 56); Text: ""; Style: @TelemetryConsentInvisibleButtonStyle; }
            }
          }
        }
      }

      Group {
        Anchor: (Height: 42);
        LayoutMode: Right;

        $C.@SmallSecondaryTextButton #TelemetryConsentPrimary {
          @Sounds = $C.@ButtonSounds;
          @Text = "Save choices";
          @Anchor = (MinWidth: 126);
        }

        Group { Anchor: (Width: 8); }

        $C.@SmallSecondaryTextButton #TelemetryConsentSecondary {
          @Sounds = $C.@ButtonSounds;
          @Text = "Not now";
          @Anchor = (MinWidth: 104);
        }
      }
    }
  }
}
