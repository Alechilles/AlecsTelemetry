$C = "Common.ui";

@TelemetryConsentHintStyle = TextTooltipStyle(
  Background: #0f1e30(0.96),
  MaxWidth: 320,
  LabelStyle: (Wrap: true, FontSize: 12, TextColor: #eef4fb),
  Padding: 12
);

@TelemetryConsentInvisibleButtonStyle = TextButtonStyle(
  Default: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Hovered: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Pressed: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Disabled: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000))
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TelemetryConsentRoot {
    Anchor: (Width: 780, Height: 710);

    #Content {
      LayoutMode: Top;
      Padding: (Left: 12, Right: 12, Top: 8, Bottom: 10);

      Group {
        Anchor: (Height: 90);

        Group #TelemetryConsentLogo {
          Anchor: (Left: 0, Top: 0, Width: 256, Height: 90);
          Background: (TexturePath: "Common/UI/Custom/AlecsTelemetryLogo.png");
        }
      }

      Label #TelemetryConsentSummary {
        Anchor: (Height: 58);
        Text: "";
        Style: (FontSize: 13, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
      }

      Group {
        Anchor: (Height: 32);

        Label {
          Anchor: (Left: 0, Width: 142, Height: 28);
          Text: "Enable all projects";
          Style: (FontSize: 13, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        CheckBox #TelemetryConsentAllEnabled {
          Anchor: (Top: 3, Left: 148, Width: 22, Height: 22);
          Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
          Padding: (Full: 4);
          Style: $C.@DefaultCheckBoxStyle;
        }

        Label #TelemetryConsentOverflow {
          Anchor: (Left: 184, Right: 0, Height: 28);
          Text: "";
          Style: (FontSize: 12, TextColor: #ffcf77, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
        }
      }

      Label #TelemetryConsentEmpty {
        Anchor: (Height: 30);
        Text: "No telemetry-enabled projects are currently registered.";
        Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group {
        FlexWeight: 1;
        Background: #13243a;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Group #TelemetryConsentViewport {
          Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 4, Right: 0, Top: 2, Bottom: 2);

          Group #TelemetryConsentRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Bottom: 0);

            Group #TelemetryConsentProjectRow0 {
              Anchor: (Height: 98);
              LayoutMode: Top;
              Background: #0f1e30;
              Padding: (Left: 8, Right: 8, Top: 6, Bottom: 6);

              Group {
                Anchor: (Height: 26);
                Label #TelemetryConsentProjectName { Anchor: (Left: 0, Right: 38, Height: 24); Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
                CheckBox #TelemetryConsentProjectEnabled { Anchor: (Top: 1, Right: 8, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              }

              Label #TelemetryConsentProjectMeta { Anchor: (Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }

              Group { Anchor: (Height: 4); }

              Group {
                Anchor: (Height: 28);
                Label { Anchor: (Left: 0, Width: 52, Height: 24); Text: "Crash"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
                CheckBox #TelemetryConsentCrashEnabled { Anchor: (Top: 1, Left: 54, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
                Label { Anchor: (Left: 88, Width: 48, Height: 24); Text: "Error"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
                CheckBox #TelemetryConsentErrorEnabled { Anchor: (Top: 1, Left: 138, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
                Label { Anchor: (Left: 172, Width: 66, Height: 24); Text: "Lifecycle"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
                CheckBox #TelemetryConsentLifecycleEnabled { Anchor: (Top: 1, Left: 240, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
                Label { Anchor: (Left: 274, Width: 86, Height: 24); Text: "Performance"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
                CheckBox #TelemetryConsentPerformanceEnabled { Anchor: (Top: 1, Left: 362, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
                Label { Anchor: (Left: 396, Width: 48, Height: 24); Text: "Usage"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
                CheckBox #TelemetryConsentUsageEnabled { Anchor: (Top: 1, Left: 446, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
                Label { Anchor: (Left: 480, Width: 86, Height: 24); Text: "Breadcrumbs"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
                CheckBox #TelemetryConsentBreadcrumbsEnabled { Anchor: (Top: 1, Left: 568, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              }
            }

            Group #TelemetryConsentProjectRow1 { Anchor: (Height: 98); LayoutMode: Top; Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 6, Bottom: 6);
              Group { Anchor: (Height: 26); Label #TelemetryConsentProjectName { Anchor: (Left: 0, Right: 38, Height: 24); Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); } CheckBox #TelemetryConsentProjectEnabled { Anchor: (Top: 1, Right: 8, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } }
              Label #TelemetryConsentProjectMeta { Anchor: (Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
              Group { Anchor: (Height: 4); }
              Group { Anchor: (Height: 28); Label { Anchor: (Left: 0, Width: 52, Height: 24); Text: "Crash"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentCrashEnabled { Anchor: (Top: 1, Left: 54, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 88, Width: 48, Height: 24); Text: "Error"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentErrorEnabled { Anchor: (Top: 1, Left: 138, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 172, Width: 66, Height: 24); Text: "Lifecycle"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentLifecycleEnabled { Anchor: (Top: 1, Left: 240, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 274, Width: 86, Height: 24); Text: "Performance"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentPerformanceEnabled { Anchor: (Top: 1, Left: 362, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 396, Width: 48, Height: 24); Text: "Usage"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentUsageEnabled { Anchor: (Top: 1, Left: 446, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } Label { Anchor: (Left: 480, Width: 86, Height: 24); Text: "Breadcrumbs"; Style: (FontSize: 11, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryConsentBreadcrumbsEnabled { Anchor: (Top: 1, Left: 568, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } }
            }

