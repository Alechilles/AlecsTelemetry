$C = "Common.ui";

@TelemetryConsentHintStyle = TextTooltipStyle(
  Background: #0f1e30(0.96),
  MaxWidth: 320,
  LabelStyle: (Wrap: true, FontSize: 12, TextColor: #eef4fb),
  Padding: 12
);

@TelemetryConsentHeaderLabel = LabelStyle(
  FontSize: 10,
  TextColor: #bfd0e5,
  HorizontalAlignment: Center,
  VerticalAlignment: Center,
  Wrap: false
);

@TelemetryConsentProjectHeaderLabel = LabelStyle(
  FontSize: 11,
  TextColor: #dce9f8,
  HorizontalAlignment: Start,
  VerticalAlignment: Center,
  Wrap: false
);

@TelemetryConsentInvisibleButtonStyle = TextButtonStyle(
  Default: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Hovered: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Pressed: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000)),
  Disabled: (Background: (Color: #00000000), LabelStyle: (FontSize: 1, TextColor: #00000000))
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TelemetryConsentRoot {
    @TitleHeight = 128;

    Anchor: (Width: 780, Height: 710);

    #Title {
      Anchor: (Height: 128, Top: 0);
      Background: "TelemetryConsentHeader.png";
      Padding: (Top: 10, Bottom: 10);

      Group #TelemetryConsentLogo {
        Anchor: (Width: 299, Height: 108);
        Background: "AlecsTelemetryLogo.png";
      }
    }

    #Content {
      Anchor: (Top: 128);
      LayoutMode: Top;
      Padding: (Left: 12, Right: 12, Top: 8, Bottom: 10);

      Label #TelemetryConsentSummary {
        Anchor: (Height: 58);
        Text: "";
        Style: (FontSize: 13, TextColor: #dce9f8, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
      }

      Label #TelemetryConsentEmpty {
        Anchor: (Height: 30);
        Text: "No telemetry-enabled projects are currently registered.";
        Style: (FontSize: 13, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Label #TelemetryConsentOverflow {
        Anchor: (Height: 22);
        Text: "";
        Style: (FontSize: 12, TextColor: #ffcf77, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Background: #13243a;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);

        Group #TelemetryConsentGridHeader {
          Anchor: (Height: 54, Left: 0, Right: 0);
          Background: #172b45;

          Label {
            Anchor: (Left: 8, Width: 236, Height: 26);
            Text: "Project";
            Style: @TelemetryConsentProjectHeaderLabel;
          }

          Label {
            Anchor: (Left: 244, Width: 66, Height: 24);
            Text: "Enable";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Enables or disables all telemetry categories for every listed mod.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentAllEnabled {
            Anchor: (Top: 28, Left: 266, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }

          Label {
            Anchor: (Left: 306, Width: 52, Height: 24);
            Text: "Crash";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Crash reports, uncaught exceptions, setup failures, start failures, and exceptional world removals.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentCrashAllEnabled {
            Anchor: (Top: 28, Left: 326, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }

          Label {
            Anchor: (Left: 366, Width: 52, Height: 24);
            Text: "Error";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Handled errors that did not crash the game, with descriptor-allowed context.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentErrorAllEnabled {
            Anchor: (Top: 28, Left: 386, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }

          Label {
            Anchor: (Left: 426, Width: 52, Height: 24);
            Text: "Life";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Lifecycle events such as setup, start, reload, and other timed mod operations.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentLifecycleAllEnabled {
            Anchor: (Top: 28, Left: 446, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }

          Label {
            Anchor: (Left: 488, Width: 58, Height: 24);
            Text: "Perf";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Performance timings and slow operation measurements.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentPerformanceAllEnabled {
            Anchor: (Top: 28, Left: 508, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }

          Label {
            Anchor: (Left: 548, Width: 66, Height: 24);
            Text: "Usage";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Feature and command usage events declared by the mod.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentUsageAllEnabled {
            Anchor: (Top: 28, Left: 570, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }

          Label {
            Anchor: (Left: 612, Width: 60, Height: 24);
            Text: "Stats";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Low-frequency aggregate stats such as heartbeat and player-count style observations.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentStatsAllEnabled {
            Anchor: (Top: 28, Left: 632, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }

          Label {
            Anchor: (Left: 672, Width: 64, Height: 24);
            Text: "Crumbs";
            Style: @TelemetryConsentHeaderLabel;
            TooltipText: "Recent breadcrumbs attached to crash or error reports to explain what happened before failure.";
            TextTooltipStyle: @TelemetryConsentHintStyle;
          }
          CheckBox #TelemetryConsentBreadcrumbsAllEnabled {
            Anchor: (Top: 28, Left: 696, Width: 22, Height: 22);
            Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
            Padding: (Full: 4);
            Style: $C.@DefaultCheckBoxStyle;
          }
        }

        Group #TelemetryConsentViewport {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          KeepScrollPosition: true;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Left: 4, Right: 0, Top: 6, Bottom: 2);

          Group #TelemetryConsentRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Bottom: 0);

            Group #TelemetryConsentProjectRow0 { Anchor: (Height: 70); Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 7, Bottom: 7);
              Group #TelemetryConsentProjectIconFrame { Anchor: (Left: 0, Top: 7, Width: 56, Height: 56); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryConsentProjectIconImage { Anchor: (Width: 56, Height: 56); Background: #203a5a; Label #TelemetryConsentProjectIconPlaceholder { Anchor: (Width: 56, Height: 56); Text: "?"; Style: (FontSize: 22, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } }
              Label #TelemetryConsentProjectName { Anchor: (Left: 64, Top: 11, Width: 172, Height: 24); Text: ""; Style: (FontSize: 14, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
              Label #TelemetryConsentProjectMeta { Anchor: (Left: 64, Top: 34, Width: 172, Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
              CheckBox #TelemetryConsentProjectEnabled { Anchor: (Top: 24, Left: 266, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              CheckBox #TelemetryConsentCrashEnabled { Anchor: (Top: 24, Left: 326, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              CheckBox #TelemetryConsentErrorEnabled { Anchor: (Top: 24, Left: 386, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              CheckBox #TelemetryConsentLifecycleEnabled { Anchor: (Top: 24, Left: 446, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              CheckBox #TelemetryConsentPerformanceEnabled { Anchor: (Top: 24, Left: 508, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              CheckBox #TelemetryConsentUsageEnabled { Anchor: (Top: 24, Left: 570, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              CheckBox #TelemetryConsentStatsEnabled { Anchor: (Top: 24, Left: 632, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
              CheckBox #TelemetryConsentBreadcrumbsEnabled { Anchor: (Top: 24, Left: 696, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
            }

            Group #TelemetryConsentProjectRow1 { Anchor: (Height: 70); Background: #0f1e30; Padding: (Left: 8, Right: 8, Top: 7, Bottom: 7);
              Group #TelemetryConsentProjectIconFrame { Anchor: (Left: 0, Top: 7, Width: 56, Height: 56); Background: (TexturePath: "Common/OptionBackgroundPatch.png", Border: 16); Padding: (Full: 0); Group #TelemetryConsentProjectIconImage { Anchor: (Width: 56, Height: 56); Background: #203a5a; Label #TelemetryConsentProjectIconPlaceholder { Anchor: (Width: 56, Height: 56); Text: "?"; Style: (FontSize: 22, TextColor: #7288a2, HorizontalAlignment: Center, VerticalAlignment: Center); } } }
              Label #TelemetryConsentProjectName { Anchor: (Left: 64, Top: 11, Width: 172, Height: 24); Text: ""; Style: (FontSize: 14, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
              Label #TelemetryConsentProjectMeta { Anchor: (Left: 64, Top: 34, Width: 172, Height: 18); Text: ""; Style: (FontSize: 11, TextColor: #9fb5ce, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
              CheckBox #TelemetryConsentProjectEnabled { Anchor: (Top: 24, Left: 266, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; }
