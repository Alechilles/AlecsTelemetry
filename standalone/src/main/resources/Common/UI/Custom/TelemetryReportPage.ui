$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer #TelemetryReportRoot {
    Anchor: (Width: 720, Height: 680);

    #Content {
      LayoutMode: Top;
      Padding: (Left: 14, Right: 14, Top: 14, Bottom: 12);

      Label #TelemetryReportProject {
        Anchor: (Height: 32);
        Text: "";
        Style: (FontSize: 17, RenderBold: true, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Group #TelemetryReportKindSelector {
        Anchor: (Height: 36);
        LayoutMode: Left;

        $C.@SmallSecondaryTextButton #TelemetryReportIssueButton { @Sounds = $C.@ButtonSounds; @Text = "Issue"; @Anchor = (MinWidth: 96); }
        Group { Anchor: (Width: 8); }
        $C.@SmallSecondaryTextButton #TelemetryReportSuggestionButton { @Sounds = $C.@ButtonSounds; @Text = "Suggestion"; @Anchor = (MinWidth: 116); }
        Label #TelemetryReportIssueSelected { Anchor: (Left: 236, Width: 72, Height: 30); Text: "Issue"; Style: (FontSize: 12, TextColor: #8fe08f, HorizontalAlignment: Start, VerticalAlignment: Center); }
        Label #TelemetryReportSuggestionSelected { Anchor: (Left: 236, Width: 104, Height: 30); Text: "Suggestion"; Style: (FontSize: 12, TextColor: #8fe08f, HorizontalAlignment: Start, VerticalAlignment: Center); }
      }

      Label #TelemetryReportReviewWarning {
        Anchor: (Height: 26);
        Text: "This server reviews reports before they are sent.";
        Style: (FontSize: 12, TextColor: #ffcf77, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
      }

      Label #TelemetryReportError {
        Anchor: (Height: 46);
        Text: "";
        Style: (FontSize: 12, TextColor: #ff9a9a, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true);
      }

      Label { Anchor: (Height: 18); Text: "Title"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
      Label #TelemetryReportTitle { Anchor: (Height: 30); Text: ""; Background: #0f1e30; Style: (FontSize: 13, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }

      Label { Anchor: (Height: 18); Text: "Description"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
      Label #TelemetryReportDescription { Anchor: (Height: 68); Text: ""; Background: #0f1e30; Style: (FontSize: 13, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Start, Wrap: true); }

      Group #TelemetryReportContactRow { Anchor: (Height: 48); LayoutMode: Top;
        Label { Anchor: (Height: 18); Text: "Contact"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); }
        Label #TelemetryReportContact { Anchor: (Height: 28); Text: ""; Background: #0f1e30; Style: (FontSize: 13, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: false); }
      }

      Group #TelemetryReportFields { Anchor: (Height: 218); LayoutMode: Top;
        Group #TelemetryReportFieldRow0 { Anchor: (Height: 26); Label #TelemetryReportFieldLabel { Anchor: (Left: 0, Width: 220, Height: 24); Text: ""; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } Label #TelemetryReportFieldValue { Anchor: (Left: 230, Right: 0, Height: 24); Text: ""; Background: #0f1e30; Style: (FontSize: 12, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center); } }
        Group #TelemetryReportFieldRow1 { Anchor: (Height: 26); Label #TelemetryReportFieldLabel { Anchor: (Left: 0, Width: 220, Height: 24); Text: ""; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } Label #TelemetryReportFieldValue { Anchor: (Left: 230, Right: 0, Height: 24); Text: ""; Background: #0f1e30; Style: (FontSize: 12, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center); } }
        Group #TelemetryReportFieldRow2 { Anchor: (Height: 26); Label #TelemetryReportFieldLabel { Anchor: (Left: 0, Width: 220, Height: 24); Text: ""; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } Label #TelemetryReportFieldValue { Anchor: (Left: 230, Right: 0, Height: 24); Text: ""; Background: #0f1e30; Style: (FontSize: 12, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center); } }
        Group #TelemetryReportFieldRow3 { Anchor: (Height: 26); Label #TelemetryReportFieldLabel { Anchor: (Left: 0, Width: 220, Height: 24); Text: ""; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } Label #TelemetryReportFieldValue { Anchor: (Left: 230, Right: 0, Height: 24); Text: ""; Background: #0f1e30; Style: (FontSize: 12, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center); } }
        Group #TelemetryReportFieldRow4 { Anchor: (Height: 26); Label #TelemetryReportFieldLabel { Anchor: (Left: 0, Width: 220, Height: 24); Text: ""; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } Label #TelemetryReportFieldValue { Anchor: (Left: 230, Right: 0, Height: 24); Text: ""; Background: #0f1e30; Style: (FontSize: 12, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center); } }
        Group #TelemetryReportFieldRow5 { Anchor: (Height: 26); Label #TelemetryReportFieldLabel { Anchor: (Left: 0, Width: 220, Height: 24); Text: ""; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } Label #TelemetryReportFieldValue { Anchor: (Left: 230, Right: 0, Height: 24); Text: ""; Background: #0f1e30; Style: (FontSize: 12, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center); } }
        Group #TelemetryReportFieldRow6 { Anchor: (Height: 26); Label #TelemetryReportFieldLabel { Anchor: (Left: 0, Width: 220, Height: 24); Text: ""; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } Label #TelemetryReportFieldValue { Anchor: (Left: 230, Right: 0, Height: 24); Text: ""; Background: #0f1e30; Style: (FontSize: 12, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center); } }
        Group #TelemetryReportFieldRow7 { Anchor: (Height: 26); Label #TelemetryReportFieldLabel { Anchor: (Left: 0, Width: 220, Height: 24); Text: ""; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } Label #TelemetryReportFieldValue { Anchor: (Left: 230, Right: 0, Height: 24); Text: ""; Background: #0f1e30; Style: (FontSize: 12, TextColor: #f1f6ff, HorizontalAlignment: Start, VerticalAlignment: Center); } }
      }

      Group #TelemetryReportCurrentLogRow { Anchor: (Height: 28); Label { Anchor: (Left: 0, Width: 210, Height: 24); Text: "Current server log"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryReportCurrentLog { Anchor: (Left: 216, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } }
      Group #TelemetryReportPreviousLogRow { Anchor: (Height: 28); Label { Anchor: (Left: 0, Width: 210, Height: 24); Text: "Previous server log"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryReportPreviousLog { Anchor: (Left: 216, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } }
      Group #TelemetryReportLoadedModsRow { Anchor: (Height: 28); Label { Anchor: (Left: 0, Width: 210, Height: 24); Text: "Installed mod list"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryReportLoadedMods { Anchor: (Left: 216, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } }
      Group #TelemetryReportDiagnosticsRow { Anchor: (Height: 28); Label { Anchor: (Left: 0, Width: 210, Height: 24); Text: "Diagnostics"; Style: (FontSize: 12, TextColor: #bfd0e5, HorizontalAlignment: Start, VerticalAlignment: Center); } CheckBox #TelemetryReportDiagnostics { Anchor: (Left: 216, Width: 22, Height: 22); Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7); Padding: (Full: 4); Style: $C.@DefaultCheckBoxStyle; } }

      Group { Anchor: (Height: 42); LayoutMode: Right;
        $C.@SmallSecondaryTextButton #TelemetryReportSubmit { @Sounds = $C.@ButtonSounds; @Text = "Submit"; @Anchor = (MinWidth: 108); }
        Group { Anchor: (Width: 8); }
        $C.@SmallSecondaryTextButton #TelemetryReportCancel { @Sounds = $C.@ButtonSounds; @Text = "Cancel"; @Anchor = (MinWidth: 96); }
      }
    }
  }
}
