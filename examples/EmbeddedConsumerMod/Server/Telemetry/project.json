{
  "telemetry": {
    "events": {
      "errors": { "supported": true },
      "lifecycle": { "supported": true },
      "breadcrumbs": { "supported": true, "automatic": true }
    },
    "performance": {
      "supported": true,
      "sampleRate": 1.0,
      "thresholdMs": 100,
      "details": {
        "plugin_start_duration": {
          "allowedFields": {
            "phase": { "type": "enum", "values": ["setup", "start"] }
          }
        }
      }
    },
    "usage": {
      "supported": true,
      "allowedEvents": ["settings_opened"],
      "details": {
        "settings_opened": {
          "allowedFields": {
            "source": { "type": "enum", "values": ["command", "settings_ui"] }
          }
        }
      }
    },
    "stats": {
      "supported": true
    }
  },
  "hosted": {
    "projectKey": "replace_with_your_public_project_key"
  }
}
